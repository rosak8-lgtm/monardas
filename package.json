{
  "name": "monardas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts playwright.config.ts eslint.config.mjs postcss.config.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.28",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "8.3.6",
    "wrangler": "^4.135.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser": "$@typescript-eslint/parser"
  },
  "type": "module"
}
