{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monardas",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/app-router-entry",
  "vars": {
    "CONTACT_TO": "yurii@monardas.com",
    "CONTACT_FROM": "MONARDAS Leads <website@send.monardas.com>",
    "MARKETING_OPTIN_MODE": "qa",
    "MARKETING_QA_EMAIL": "yurii@monardas.com",
    "MARKETING_QA_SEGMENT_ID": "dfef2b7a-a2f9-4e35-a578-b9466d900eea",
    "RESEND_OPTIN_SEGMENT_ID": "c0729422-ded7-4bc6-bef9-a4d591aa2818"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "MARKETING_DB",
      "database_name": "monardas-marketing-consent",
      "database_id": "b446e6af-2e96-4f1f-aef5-6731915e1c6b",
      "migrations_dir": "migrations"
    }
  ]
}
